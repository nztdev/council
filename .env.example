# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is
# safe to expose publicly - it's designed for client-side use and access
# is enforced by Row Level Security (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
